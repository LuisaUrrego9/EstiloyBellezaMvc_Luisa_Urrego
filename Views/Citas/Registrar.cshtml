
@model EstiloyBellezaMvc.Models.Cita

@{
    ViewData["Title"] = "Registrar cita";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <h1 class="titulo-salon">Agenda tu cita</h1>
        <p>En Estilo y Belleza queremos ayudarte a lucir increíble.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow p-4">
                <h3 class="mb-4 text-center">Datos del cliente</h3>

                <form asp-controller="Citas"
                    asp-action="Registrar"
                    method="post"
                    id="formularioCita">

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">
                            Nombre completo
                        </label>
                        <input asp-for="Nombre" class="form-control"
                               placeholder="Escribe tu nombre" />
                        <span asp-validation-for="Nombre"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefono" class="form-label">
                            Teléfono
                        </label>
                        <input asp-for="Telefono" class="form-control"
                               placeholder="Número de contacto" />
                        <span asp-validation-for="Telefono"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Servicio" class="form-label">
                            Servicio que deseas
                        </label>
                        <select asp-for="Servicio" class="form-select">
                            <option value="">Selecciona un servicio</option>
                            <option value="Manicure">Manicure</option>
                            <option value="Pedicure">Pedicure</option>
                            <option value="Corte y peinado">Corte y peinado</option>
                            <option value="Coloración">Coloración</option>
                            <option value="Maquillaje">Maquillaje</option>
                            <option value="Tratamiento capilar">
                                Tratamiento capilar
                            </option>
                        </select>
                        <span asp-validation-for="Servicio"
                              class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Fecha" class="form-label">
                                Fecha
                            </label>
                            <input asp-for="Fecha" type="date"
                                   class="form-control" />
                            <span asp-validation-for="Fecha"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Hora" class="form-label">
                                Hora
                            </label>
                            <input asp-for="Hora" type="time"
                                   class="form-control" />
                            <span asp-validation-for="Hora"
                                  class="text-danger"></span>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-salon w-100">
                        Registrar cita
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
